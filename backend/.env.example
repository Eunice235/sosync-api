# Copy to .env and adjust. Every value here has a working development default in
# application.yml, so the service starts with none of them set.

# ── Database ────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_NAME=sosync_db
DB_USERNAME=sosync
DB_PASSWORD=sosync

# ── API ─────────────────────────────────────────────────────────────────────────
SERVER_PORT=8090

# ── Security ────────────────────────────────────────────────────────────────────
# MUST be replaced before any deployment. Minimum 32 characters (HS256).
# Holding this value is enough to mint an admin token.
SOSYNC_JWT_SECRET=sosync-dev-secret-change-me-in-production-0123456789abcdef

# ── Notifications ───────────────────────────────────────────────────────────────
# true  -> deliveries are recorded as SIMULATED and exposed over the API (prototype default)
# false -> requires real SMS/FCM gateway implementations to be wired in
SOSYNC_SIMULATE_NOTIFICATIONS=true

# ── Demo data ───────────────────────────────────────────────────────────────────
SOSYNC_SEED_DEMO=true
